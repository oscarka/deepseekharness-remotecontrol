{
  "name": "@local/dsh-feishu",
  "version": "0.7.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Mobile Web & Feishu Remote Control Hub for DeepSeek Harness (DSH) and local AI coding harnesses.",
  "icon": "./icon.svg",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
