{
  "name": "@local/dsh-feishu",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Control live DSH agents from a Feishu self-built app over a long connection.",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "1.76.0"
  }
}
